<Window x:Class="QuickerPlaces.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:QuickerPlaces.Converters"
        xmlns:models="clr-namespace:QuickerPlaces.Models"
        mc:Ignorable="d"
        Title="{Binding AppName}"
        Width="1000"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        d:DesignHeight="650" d:DesignWidth="1000">

    <Window.Resources>
        <converters:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />
        <converters:CollectionCountToVisibilityConverter x:Key="CollectionCountToVisibilityConverter" />

        <!--
            Row text style for the places grid: normally just the theme's
            default TextBlock look, but a favourited place's row gets a
            slightly brighter, semibold treatment instead of the old
            checkbox column — see the Favourite column's replacement below
            for why the checkbox went away. Applied via each
            DataGridTextColumn's ElementStyle (and directly on the Type
            column's own TextBlock) rather than the DataGridRow's
            Foreground, because DataGridCell's own style already sets an
            explicit Foreground per cell — a row-level Setter would never
            win against that, so the accent has to be applied at the same
            TextBlock level the cell style targets.
        -->
        <Style x:Key="PlaceRowText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent.Hover}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Small Folder / URL glyph, drawn from plain Path/Ellipse
            primitives rather than an icon font — the app ships zero
            external assets (see Theme.xaml's font comment), and a missing
            or mismatched glyph in a font like Segoe MDL2 Assets would be a
            much more visible failure than a slightly plain vector shape.
            Both glyphs are always present in the visual tree; only one is
            ever Visible, toggled by comparing the bound PlaceViewModel's
            Type against the enum values via x:Static. Reused for both the
            grid's Type column and the favourite bubbles. Folder and URL
            use two different (but close) accent tints, per request, rather
            than one shared icon color.
        -->
        <DataTemplate x:Key="TypeIconTemplate">
            <Grid Width="14" Height="12" VerticalAlignment="Center">
                <Path Data="M1,2 L5,2 L6,3.5 L13,3.5 L13,10 L1,10 Z"
                      Width="14" Height="12" Stretch="Uniform">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="{StaticResource Text.Secondary}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PlaceType.Folder}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PlaceType.Url}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <!-- Two overlapping ring outlines, standing in for a chain-link/URL glyph. -->
                    <Ellipse Width="8" Height="8" StrokeThickness="1.4"
                             Stroke="{StaticResource Accent.Hover}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" StrokeThickness="1.4"
                             Stroke="{StaticResource Accent.Hover}"
                             HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!--
            Shared per-row/per-bubble context menu content. A ContextMenu is
            shown in its own Popup, not the visual/logical tree it's
            attached to, so its content can't reach the row/bubble via
            ordinary DataContext inheritance — every binding below goes
            through PlacementTarget explicitly instead (deliberately not
            relying on ContextMenu's own DataContext at all, which is a
            well-known WPF gray area): Tag on the row/bubble is bound to
            the window's MainViewModel for the Command half, and
            PlacementTarget.DataContext (the row/bubble's own PlaceViewModel)
            supplies the CommandParameter half.
        -->
        <ContextMenu x:Key="PlaceContextMenu">
            <MenuItem Header="Open"
                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      FontWeight="Bold" />
            <MenuItem Header="Rename Alias"
                      Command="{Binding PlacementTarget.Tag.RenameAliasCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Edit Path/URL"
                      Command="{Binding PlacementTarget.Tag.EditResourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Toggle Favourite"
                      Command="{Binding PlacementTarget.Tag.ToggleFavouriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Remove"
                      Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- SI §6.4 — a bubble's own right-click menu offers removal directly, without going back to the grid. Open is included too, for convenience. -->
        <ContextMenu x:Key="BubbleContextMenu">
            <MenuItem Header="Open"
                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      FontWeight="Bold" />
            <MenuItem Header="Remove from Favourites"
                      Command="{Binding PlacementTarget.Tag.ToggleFavouriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!--
                RowDefinition isn't a FrameworkElement, so it doesn't inherit
                DataContext the way a normal element does — a plain
                "{Binding IsGridExpanded}" here would silently fail to find
                a source. Binding via ElementName to the root Grid sidesteps
                that (it resolves by name in the XAML namescope, then reads
                *that* element's DataContext explicitly), which is the
                standard, reliable way to data-bind a RowDefinition.

                This Star/zero split only decides how space is divided
                *inside* a given window height. The window's own height —
                whether it hugs just the header + favourites, or allows
                room for this row at all — is handled separately in
                MainWindow.xaml.cs (see ApplyGridExpandedState), since a
                Star row inside a window that's sizing itself to content
                would otherwise try to grow to fit every place in the list.
            -->
            <RowDefinition Height="{Binding DataContext.IsGridExpanded, ElementName=RootGrid, Converter={StaticResource BoolToGridLengthConverter}}" />
        </Grid.RowDefinitions>

        <!-- Header: monogram glyph, app name + subheader, view/action row -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10"
                    Background="{StaticResource Accent}" VerticalAlignment="Top">
                <TextBlock Text="{Binding Monogram}" FontWeight="Bold" FontSize="14"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding SubHeaderText}" FontSize="13"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!--
                    Grid show/hide now lives in the header (rather than its
                    own row above the grid) so it's reachable no matter
                    whether the grid is currently showing. Toggling it also
                    resizes the window itself — see
                    MainWindow.xaml.cs/ApplyGridExpandedState — collapsing
                    down to just this header + favourites, or restoring a
                    fixed height with room for the grid, instead of the old
                    behaviour of just leaving blank space below.
                -->
                <Button Margin="0,0,20,0" Command="{Binding ToggleGridCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="Hide List" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGridExpanded}" Value="False">
                                    <Setter Property="Content" Value="Show List" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Import..." Command="{Binding ImportCommand}" Margin="0,0,8,0" />
                <Button Content="Export..." Command="{Binding ExportCommand}" Margin="0,0,16,0" />
                <Button Content="Add Folder" Command="{Binding AddFolderCommand}" Margin="0,0,8,0" />
                <Button Content="Add URL" Command="{Binding AddUrlCommand}" />
            </StackPanel>
        </Grid>

        <!--
            Favourites (SI §6.4) — one-click bubbles above the grid. Each
            bubble is a Button styled as a pill (Button.Bubble); clicking it
            opens the place, matching a grid row's double-click. Drag to
            reorder is handled in code-behind (Bubble_PreviewMouseMove
            starts the drag; FavouritesPanel_Drop computes the new index
            and calls MainViewModel.MoveFavourite). Each bubble's label is
            prefixed with the same Folder/URL glyph used in the grid.
        -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Right-click a place below and choose &quot;Toggle Favourite&quot; to pin it here."
                       Foreground="{StaticResource Text.Faint}" FontStyle="Italic"
                       Visibility="{Binding FavouritePlaces.Count, Converter={StaticResource CollectionCountToVisibilityConverter}}" />

            <ItemsControl x:Name="FavouritesItemsControl" ItemsSource="{Binding FavouritePlaces}"
                          AllowDrop="True" DragOver="FavouritesItemsControl_DragOver" Drop="FavouritesItemsControl_Drop">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Button.Bubble}"
                                Tag="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext}"
                                ContextMenu="{StaticResource BubbleContextMenu}"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.OpenCommand}"
                                CommandParameter="{Binding}"
                                PreviewMouseLeftButtonDown="Bubble_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="Bubble_PreviewMouseMove">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TypeIconTemplate}"
                                                Focusable="False" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Alias}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--
            "All Places" section label. Collapses along with the grid below
            it (rather than sitting there on its own) so hiding the list
            doesn't leave an orphaned heading — see ApplyGridExpandedState
            in MainWindow.xaml.cs for the matching window-height change.
        -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGridExpanded}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <TextBlock Text="All Places" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <!--
            Places grid (SI §6.3). Collapsible via the row's bound Height
            (Row 3 above) rather than just Visibility, so collapsing it
            actually reclaims the vertical space for the window instead of
            leaving a blank gap (see BoolToGridLengthConverter's remarks).
        -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Places}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext}" />
                    <Setter Property="ContextMenu" Value="{StaticResource PlaceContextMenu}" />
                    <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="*" ElementStyle="{StaticResource PlaceRowText}" />

                <!-- Folder/URL glyph ahead of the label, instead of plain text alone. -->
                <DataGridTemplateColumn Header="Type" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TypeIconTemplate}"
                                                Focusable="False" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource PlaceRowText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Path / URL" Binding="{Binding Resource}" Width="2*" ElementStyle="{StaticResource PlaceRowText}" />

                <!--
                    The old Favourite checkbox column is gone — a favourited
                    row is now shown by accenting its own text (PlaceRowText
                    above, applied to every column's TextBlock) rather than
                    a separate tick box.
                -->
                <DataGridTextColumn Header="Date Added" Binding="{Binding DateAdded, StringFormat={}{0:d}}" Width="110" ElementStyle="{StaticResource PlaceRowText}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
